# FollowScope — variables de entorno de ejemplo.
# Copia este archivo a .env.local y ajusta los valores. NUNCA incluyas secretos reales aquí.

# --- Límites de importación (públicos: se usan en el navegador) ---
# Tamaño máximo de un archivo JSON/CSV/TXT suelto, en MB.
NEXT_PUBLIC_MAX_FILE_MB=100
# Tamaño máximo descomprimido de cada fichero extraído de un ZIP, en MB.
NEXT_PUBLIC_MAX_ZIP_ENTRY_MB=200
# Número máximo de registros por lista (seguidores o seguidos).
NEXT_PUBLIC_MAX_RECORDS=1000000

# --- Integraciones oficiales (NO usadas todavía en el MVP) ---
# Se dejan documentadas para una futura fase con backend. Los secretos solo deben
# existir en el servidor: nunca uses el prefijo NEXT_PUBLIC_ para ellos.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
